#!/usr/bin/env bash
# Pre-commit guard: no banned content (ROMs/BIOS/keys/game art), no scratch
# agent tooling (§79), no license violations in the commit's tree, no manifest
# policy drift (execution/cheats/delivery vs fill_manifest_data), and no
# unreconciled Orbit design evidence.
#
# Install once per clone:  scripts/install-hooks.sh
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# --- identity: commits carry a real, linkable author ------------------------
# Placeholder identities (appdev@local, v@local, <host>.local) cannot be linked
# to a GitHub account and blur who holds the copyright. Agents commit as the
# maintainer and disclose themselves with an Assisted-by:/Co-Authored-By:
# trailer instead (CONTRIBUTING.md, "AI-assisted contributions").
author_email="$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')"
if printf '%s' "$author_email" | grep -qiE '(@local|\.local|@localhost|example\.(com|org|invalid))$|^$'; then
  echo ""
  echo "✋ COMMIT BLOCKED — placeholder author identity: <$author_email>"
  echo "  Set a real identity: git config --global user.email <you>@users.noreply.github.com"
  exit 1
fi

# --- §79: scratch agent tooling never enters the repo -----------------------
# Screenshot drivers, input injectors, capture helpers, probe scripts are
# /tmp-only, wiped when the task ends, never committed. Only real permanent
# tests live in test/.
scratch_hits="$(git diff --cached --name-only --diff-filter=ACM | grep -E \
  '(_probe\.(py|dart|sh)|probe_[a-z_]+\.(py|dart|sh)|screenshot[_-]?.*\.(py|sh)|shot_[a-z_]+\.(py|sh)|inject[_-]?.*\.(py|sh)|capture[_-]?.*\.(py|sh)|xdotool|ydotool|wtype)' \
  || true)"
if [ -n "$scratch_hits" ]; then
  echo ""
  echo "✋ COMMIT BLOCKED — §79 scratch tooling in staged files:"
  echo "$scratch_hits" | sed 's/^/    /'
  echo ""
  echo "  Scratch/probe/screenshot/injection scripts NEVER enter the repo —"
  echo "  keep them in /tmp, wipe when the task ends (CONTRIBUTING.md)."
  echo "  Permanent tests belong in test/ with real assertions."
  exit 1
fi

# --- product only: no design, lab or agent material --------------------------
# This repository holds the app and its public docs. Design studies, labs,
# agent configuration and internal notes live in the private workspace, never
# here (they once brought commercial box art into the public history).
internal_hits="$(git diff --cached --name-only --diff-filter=ACM | grep -E \
  '^(design/|tools/moonboard/|\.ezcore/|\.opencode/|\.codex/|\.continue/|\.cursor/|\.windsurf/|CLAUDE\.md$|project\.md$|IDEA\.md$|.*MASTER-PROMPT.*|.*handoff\.md$|\.github/copilot-instructions\.md$)' \
  || true)"
if [ -n "$internal_hits" ]; then
  echo ""
  echo "✋ COMMIT BLOCKED — design, lab or agent material does not belong in the public repository:"
  echo "$internal_hits" | sed 's/^/    /'
  echo ""
  echo "  Put it in the private ezCORE workspace instead."
  exit 1
fi

# --- banned content: ROMs/BIOS/keys/game art --------------------------------
if ! bash "$root/scripts/banned_content_scan.sh" > /tmp/ezcore-scan.log 2>&1; then
  echo ""
  echo "✋ COMMIT BLOCKED — banned content in the tree:"
  grep -v "^BANNED CONTENT IN REPO:" /tmp/ezcore-scan.log | sed 's/^/    /'
  echo ""
  echo "  ROMs/BIOS/keys/game art must never be committed (see CONTRIBUTING.md)."
  echo "  If this is a false positive, fix scripts/banned_content_scan.sh's allowlist."
  exit 1
fi

if [ -f "$root/scripts/license_audit.py" ]; then
  if ! python3 "$root/scripts/license_audit.py" > /tmp/ezcore-license.log 2>&1; then
    echo ""
    echo "✋ COMMIT BLOCKED — license/delivery violation:"
    tail -n +2 /tmp/ezcore-license.log | sed 's/^/    /'
    echo ""
    echo "  See CONTRIBUTING.md → Licensing of contributions."
    exit 1
  fi
fi

# --- manifest policy gate (same gate release.sh runs; drift must fail early) -
# Read-only check, no git calls: cannot loop or rewrite the tree.
if [ -f "$root/scripts/fill_manifest_data.py" ]; then
  if ! python3 "$root/scripts/fill_manifest_data.py" --check \
      > /tmp/ezcore-manifest.log 2>&1; then
    echo ""
    echo "✋ COMMIT BLOCKED — manifest policy drift (execution/cheats/delivery):"
    sed 's/^/    /' /tmp/ezcore-manifest.log
    echo ""
    echo "  Fix: python3 scripts/fill_manifest_data.py  (then review the diff)"
    exit 1
  fi
fi

