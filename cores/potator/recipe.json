{
  "build": {
    "args": {
      "default": []
    },
    "dir": "platform/libretro",
    "jobs": 4,
    "system": "make",
    "target": "libretro"
  },
  "hooks": [],
  "id": "potator",
  "license_files": [
    "LICENSE",
    "COPYING"
  ],
  "outputs": {
    "android-arm64": "potator_libretro.so",
    "linux-x64": "potator_libretro.so",
    "macos-arm64": "potator_libretro.dylib",
    "windows-x64": "potator_libretro.dll"
  },
  "patches": [],
