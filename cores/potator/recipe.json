  "pin_verified": true,
  "pinned_targets": [
    "android-arm64",
    "linux-x64"
  ],
  "platforms": [
    "macos-arm64",
    "android-arm64",
    "linux-x64",
    "windows-x64"
  ],
  "schema": 1,
  "sign": {
    "macos-arm64": "adhoc-codesign"
