# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Build outputs (reproducible via scripts/build_core.sh --fetch-headers + --tier1)
build/
native/*
!native/pin-waivers/
runtime/build/
runtime/build-*/
runtime/Testing/
runtime/build-*/Testing/
runtime/external/

# Verified-artifact sidecars (see verifyPinnedFile): regenerated on stage.
*.ezpin
*.dylib
*.so
*.dll
*.o
*.a

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material must never be committed (see android signing
# config: EZCORE_KEYSTORE_* env). Local debug keystores are auto-created.
*.jks
*.keystore
key.properties
android/key.properties

# Internal design exploration — boards that study other companies' design
# languages are kept local-only; the shipped identity lives in
# design/ezcore-orbit/. See TRADEMARKS.md.
design/moonboard/
/moonboard/

# Stray vendor fetch from mupen64plus exploration (referenced by nothing).
/Mupen64plus/

# Release outputs (assembled by scripts/release.sh; attached to GitHub
# Releases, never committed).
dist/

# Local ROM drop folder for development. ROMs are never committed — see
# CONTRIBUTING.md hard rule 1; the pre-commit hook blocks them anyway.
roms/
